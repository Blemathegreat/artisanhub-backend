# Copy this file to .env and fill in YOUR values. Never commit .env.
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=artisanhub
DB_SSL=false

JWT_SECRET=change-me-to-a-long-random-string

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of websites allowed to call this API
FRONTEND_URL=http://localhost:5173

# Nominatim asks you to identify your app. Put your real contact here.
GEOCODER_USER_AGENT=ArtisanHub/1.0 (you@example.com)
